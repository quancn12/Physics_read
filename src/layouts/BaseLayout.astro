---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import SettingsModal from '../components/SettingsModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Cuna Physics — Tủ sách Vật lý cá nhân',
  description = 'Website đọc giáo trình và tài liệu Vật lý cá nhân của Cuna, hỗ trợ đọc PDF mượt mà, tra cứu đáp án và ghi nhớ tiến độ.',
  currentPath = '/'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={`${baseUrl}/assets/mascot/sadness_yawn.png`} />
  
  <!-- Preload Theme Before Render to avoid flicker -->
  <script is:inline>
    try {
      const raw = localStorage.getItem('cuna_preferences_v1');
      if (raw) {
        const p = JSON.parse(raw);
        if (p.theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      }
    } catch (e) {}
  </script>
</head>
<body class="bg-physics-pattern">
  <Header currentPath={currentPath} />
  
  <main class="main-content">
    <slot />
  </main>

  <Footer />

  <SearchModal />
  <SettingsModal />
</body>
</html>

<style>
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
