---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="search-modal" class="search-backdrop" style="display: none;" role="dialog" aria-modal="true">
  <div class="search-window">
    <!-- Search Bar Input -->
    <div class="search-input-wrapper">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Tìm kiếm công thức, khái niệm (hỗ trợ gõ không dấu)..." 
        autocomplete="off"
      />
      <div id="search-loading" class="search-spinner" style="display: none;"></div>
      <button id="search-close-btn" class="search-esc-btn" title="Đóng (Esc)">Esc</button>
    </div>

    <!-- Search Results List -->
    <div id="search-results-container" class="search-results">
      <!-- Default Initial Hint -->
      <div id="search-hint" class="search-state-box">
        <img src={`${baseUrl}/assets/mascot/sadness_standing.png`} class="search-state-img" alt="Sadness" />
        <p class="search-state-title">Tìm kiếm toàn tập Cơ sở Vật lý</p>
        <p class="search-state-desc">Hỗ trợ gõ tiếng Việt có dấu hoặc không dấu. Ví dụ: <code>dong luc hoc</code>, <code>bernoulli</code>, <code>entropy</code></p>
      </div>

      <!-- No Results State -->
      <div id="search-no-results" class="search-state-box" style="display: none;">
        <img src={`${baseUrl}/assets/mascot/sadness_deflated.png`} class="search-state-img-wide" alt="Sadness Deflated" />
        <p class="search-state-title">Không tìm thấy kết quả nào</p>
        <p class="search-state-desc">Hãy thử từ khoá ngắn hơn hoặc không dấu xem sao nha!</p>
      </div>

      <!-- Results list items -->
      <ul id="search-items-list" class="search-items-list" style="display: none;"></ul>
    </div>
  </div>
</div>

<style>
  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    animation: fadeIn 0.15s ease-out;
  }
  .search-window {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    width: 90%;
    max-width: 680px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
  }
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--border-color);
  }
  .search-icon {
    color: var(--primary);
    flex-shrink: 0;
  }
  #search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1.05rem;
    color: var(--text-primary);
    font-family: inherit;
    font-weight: 500;
  }
  .search-esc-btn {
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .search-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--border-color);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .search-results {
    overflow-y: auto;
    padding: 1rem;
    flex: 1;
  }
  .search-state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }
  .search-state-img {
    width: 90px;
    height: auto;
    margin-bottom: 1rem;
  }
  .search-state-img-wide {
    width: 160px;
    height: auto;
    margin-bottom: 1rem;
  }
  .search-state-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }
  .search-state-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .search-state-desc code {
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .search-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  :global(.search-item-link) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }
  :global(.search-item-link:hover) {
    border-color: var(--primary);
    background: var(--primary-light);
    transform: translateY(-1px);
  }
  :global(.search-item-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  :global(.search-item-title) {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  :global(.search-item-page) {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--bg-surface);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--primary-border);
  }
  :global(.search-item-snippet) {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }
</style>

<script>
  import { getSearchEngine, performSearch } from '../utils/search';

  const modal = document.getElementById('search-modal') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const triggerBtn = document.getElementById('header-search-btn');
  const closeBtn = document.getElementById('search-close-btn');
  const spinner = document.getElementById('search-loading') as HTMLElement;
  const hintBox = document.getElementById('search-hint') as HTMLElement;
  const noResultsBox = document.getElementById('search-no-results') as HTMLElement;
  const itemsList = document.getElementById('search-items-list') as HTMLUListElement;

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
  let engine: any = null;
  let debounceTimer: any = null;

  async function openSearch() {
    if (!modal) return;
    modal.style.display = 'flex';
    input.focus();
    input.select();

    if (!engine) {
      if (spinner) spinner.style.display = 'block';
      try {
        engine = await getSearchEngine(baseUrl);
      } catch (e) {
        console.error('Lỗi khởi tạo MiniSearch:', e);
      } finally {
        if (spinner) spinner.style.display = 'none';
      }
    }
  }

  function closeSearch() {
    if (!modal) return;
    modal.style.display = 'none';
  }

  triggerBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  // Shortcut key '/' or 'Cmd+K' / 'Ctrl+K'
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      openSearch();
    } else if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    } else if (e.key === 'Escape' && modal?.style.display === 'flex') {
      closeSearch();
    }
  });

  // Handle typing
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const val = input.value.trim();

    if (!val) {
      hintBox.style.display = 'flex';
      noResultsBox.style.display = 'none';
      itemsList.style.display = 'none';
      itemsList.innerHTML = '';
      return;
    }

    debounceTimer = setTimeout(() => {
      if (!engine) return;
      const results = performSearch(engine, val, 25);

      hintBox.style.display = 'none';
      if (results.length === 0) {
        noResultsBox.style.display = 'flex';
        itemsList.style.display = 'none';
        itemsList.innerHTML = '';
      } else {
        noResultsBox.style.display = 'none';
        itemsList.style.display = 'flex';
        
        itemsList.innerHTML = results.map(r => {
          let targetUrl = `${baseUrl}/books/${r.bookSlug}/read/${r.docPrefix}/?page=${r.page}`;
          if (r.docPrefix === 'dap-an') {
            targetUrl = `${baseUrl}/books/${r.bookSlug}/dap-an/?page=${r.page}`;
          } else if (r.docPrefix === 'phu-luc') {
            targetUrl = `${baseUrl}/books/${r.bookSlug}/phu-luc/?page=${r.page}`;
          }

          return `
            <li>
              <a href="${targetUrl}" class="search-item-link">
                <div class="search-item-header">
                  <span class="search-item-title">${r.title}</span>
                  <span class="search-item-page">Trang ${r.page}</span>
                </div>
                <div class="search-item-snippet">${r.snippet}</div>
              </a>
            </li>
          `;
        }).join('');
      }
    }, 150);
  });
</script>
