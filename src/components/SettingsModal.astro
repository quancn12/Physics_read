---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="settings-modal" class="settings-backdrop" style="display: none;" role="dialog" aria-modal="true">
  <div class="settings-window">
    <div class="settings-header">
      <div class="settings-title-group">
        <span class="settings-badge">Cá nhân hoá</span>
        <h3>Cài đặt & Dữ liệu đọc</h3>
      </div>
      <button id="settings-close-btn" class="settings-esc-btn" title="Đóng">✕</button>
    </div>

    <div class="settings-body">
      <!-- Sync & Privacy notice -->
      <div class="settings-notice">
        <img src={`${baseUrl}/assets/mascot/sadness_classic.png`} class="notice-mascot" alt="Sadness" />
        <div class="notice-text">
          <strong>Lưu trữ cục bộ an toàn:</strong> Mọi tiến độ đọc, vị trí trang sách và tuỳ chọn zoom được lưu trên trình duyệt của riêng bạn (`localStorage`).
        </div>
      </div>

      <!-- Actions Group -->
      <div class="settings-actions-list">
        <!-- Export -->
        <div class="setting-item">
          <div>
            <div class="setting-item-label">Sao lưu dữ liệu (Export JSON)</div>
            <div class="setting-item-desc">Tải file dữ liệu về máy để chuyển sang thiết bị khác (iPad, máy tính trường...).</div>
          </div>
          <button id="btn-export-data" class="btn-secondary" style="font-size:0.85rem; padding: 0.5rem 1rem;">
            Tải file JSON
          </button>
        </div>

        <!-- Import -->
        <div class="setting-item">
          <div>
            <div class="setting-item-label">Khôi phục dữ liệu (Import JSON)</div>
            <div class="setting-item-desc">Tải lên file JSON đã sao lưu trước đó.</div>
          </div>
          <div>
            <input type="file" id="import-file-input" accept=".json" style="display: none;" />
            <button id="btn-import-data" class="btn-secondary" style="font-size:0.85rem; padding: 0.5rem 1rem;">
              Chọn file
            </button>
          </div>
        </div>

        <!-- Reset -->
        <div class="setting-item danger-item">
          <div>
            <div class="setting-item-label" style="color: var(--accent-rose);">Xoá toàn bộ tiến độ (Reset)</div>
            <div class="setting-item-desc">Đặt lại vị trí đọc và dấu tích hoàn thành các chương.</div>
          </div>
          <button id="btn-reset-data" class="btn-danger" style="font-size:0.85rem; padding: 0.5rem 1rem;">
            Đặt lại
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .settings-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: fadeIn 0.15s ease-out;
  }
  .settings-window {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 540px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }
  .settings-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid var(--border-color);
  }
  .settings-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }
  .settings-title-group h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-top: 0.2rem;
  }
  .settings-esc-btn {
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .settings-body {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .settings-notice {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
  }
  .notice-mascot {
    width: 44px;
    height: auto;
  }
  .notice-text {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .settings-actions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .setting-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-color);
  }
  .setting-item.danger-item {
    border-bottom: none;
    padding-bottom: 0;
  }
  .setting-item-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }
  .setting-item-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .btn-danger {
    background: #FFF1F2;
    color: #E11D48;
    border: 1.5px solid #FECDD3;
    font-weight: 700;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-danger:hover {
    background: #E11D48;
    color: #FFFFFF;
  }
</style>

<script>
  import { exportCunaData, importCunaData, resetAllCunaData } from '../utils/storage';

  const modal = document.getElementById('settings-modal') as HTMLElement;
  const openBtn = document.getElementById('settings-open-btn');
  const closeBtn = document.getElementById('settings-close-btn');

  const exportBtn = document.getElementById('btn-export-data');
  const importBtn = document.getElementById('btn-import-data');
  const fileInput = document.getElementById('import-file-input') as HTMLInputElement;
  const resetBtn = document.getElementById('btn-reset-data');

  function openSettings() {
    if (modal) modal.style.display = 'flex';
  }
  function closeSettings() {
    if (modal) modal.style.display = 'none';
  }

  openBtn?.addEventListener('click', openSettings);
  closeBtn?.addEventListener('click', closeSettings);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSettings();
  });

  // Export
  exportBtn?.addEventListener('click', () => {
    const dataStr = exportCunaData();
    const blob = new Blob([dataStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `cuna-physics-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Import
  importBtn?.addEventListener('click', () => {
    fileInput?.click();
  });

  fileInput?.addEventListener('change', (e: any) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      const content = evt.target?.result as string;
      if (content && importCunaData(content)) {
        alert('🎉 Đã khôi phục dữ liệu thành công! Trang web sẽ tải lại.');
        window.location.reload();
      } else {
        alert('❌ File không đúng định dạng sao lưu của Cuna.');
      }
    };
    reader.readAsText(file);
  });

  // Reset
  resetBtn?.addEventListener('click', () => {
    if (confirm('⚠️ Bạn có chắc chắn muốn xoá toàn bộ tiến độ và ghi chú đọc sách không?')) {
      resetAllCunaData();
      alert('Đã đặt lại dữ liệu thành công.');
      window.location.reload();
    }
  });
</script>
