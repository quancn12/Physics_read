---
import { getBookMetadata } from '../../../utils/books';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { bookSlug: 'co-so-vat-ly-tap-1' } }
  ];
}

const { bookSlug } = Astro.params;
const book = getBookMetadata(bookSlug);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = `${baseUrl}/books/${book.slug}/pdf/${book.appendix.fileName}`;
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phụ lục tra cứu (A – G) — {book.title} | Cuna Physics</title>
  <link rel="icon" type="image/png" href={`${baseUrl}/assets/mascot/sadness_yawn.png`} />
  <script is:inline>
    try {
      const raw = localStorage.getItem('cuna_preferences_v1');
      if (raw && JSON.parse(raw).theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch (e) {}
  </script>
</head>
<body class="standalone-viewer-body">
  <header class="standalone-toolbar">
    <div class="tool-left">
      <a href={`${baseUrl}/books/${book.slug}/`} class="tool-btn">
        ← Về danh mục sách
      </a>
      <h3 class="standalone-title">Phụ lục tra cứu tổng hợp (A – G)</h3>
    </div>
    <div class="tool-right">
      <select id="jump-select" class="tool-select">
        {book.appendix.items.map((item) => (
          <option value={item.page}>Phụ lục {item.code}: {item.title}</option>
        ))}
      </select>
    </div>
  </header>

  <main class="standalone-main" id="standalone-main">
    <div id="pages-container" class="standalone-pages"></div>
  </main>

  <script is:inline define:vars={{ pdfUrl, baseUrl, totalPages: book.appendix.totalPages }}>
    window.STANDALONE_PDF_CONFIG = {
      pdfUrl,
      baseUrl,
      totalPages
    };
  </script>

  <script type="module">
    const config = window.STANDALONE_PDF_CONFIG;
    const baseUrl = config.baseUrl.replace(/\/$/, '');
    const container = document.getElementById('pages-container');
    const select = document.getElementById('jump-select');

    const pdfjsLib = await import(`${baseUrl}/vendor/pdfjs/pdf.min.mjs`);
    pdfjsLib.GlobalWorkerOptions.workerSrc = `${baseUrl}/vendor/pdfjs/pdf.worker.min.mjs`;

    const doc = await pdfjsLib.getDocument({
      url: config.pdfUrl,
      cMapUrl: `${baseUrl}/vendor/pdfjs/cmaps/`,
      cMapPacked: true
    }).promise;

    for (let i = 1; i <= doc.numPages; i++) {
      const wrap = document.createElement('div');
      wrap.id = `app-page-${i}`;
      wrap.className = 'standalone-page-card';
      container.appendChild(wrap);

      const page = await doc.getPage(i);
      const vp = page.getViewport({ scale: 1.5 });
      const canvas = document.createElement('canvas');
      canvas.width = vp.width;
      canvas.height = vp.height;
      canvas.style.width = '100%';
      canvas.style.display = 'block';

      wrap.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      page.render({ canvasContext: ctx, viewport: vp });
    }

    select?.addEventListener('change', (e) => {
      const p = e.target.value;
      const target = document.getElementById(`app-page-${p}`);
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const initialPage = new URLSearchParams(window.location.search).get('page');
    if (initialPage) {
      setTimeout(() => {
        document.getElementById(`app-page-${initialPage}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    }
  </script>
</body>
</html>

<style>
  .standalone-viewer-body {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #525659;
    margin: 0;
  }
  .standalone-toolbar {
    height: 52px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
  }
  .tool-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .standalone-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .tool-btn {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
  }
  .tool-select {
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .standalone-main {
    flex: 1;
    overflow-y: auto;
    padding: 2rem 1rem 5rem;
    display: flex;
    justify-content: center;
  }
  .standalone-pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 800px;
    width: 100%;
  }
  :global(.standalone-page-card) {
    background: #FFFFFF;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
  }
</style>
