---
import fs from 'node:fs';
import path from 'node:path';
import { getBookMetadata } from '../../../utils/books';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { bookSlug: 'co-so-vat-ly-tap-1' } }
  ];
}

const { bookSlug } = Astro.params;
const book = getBookMetadata(bookSlug);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = `${baseUrl}/books/${book.slug}/pdf/${book.appendix.fileName}`;

// Load pre-exported appendix HTML
const htmlFilePath = path.resolve('./src/content/chapters/phu-luc.html');
let appendixHtml = '';
if (fs.existsSync(htmlFilePath)) {
  appendixHtml = fs.readFileSync(htmlFilePath, 'utf-8');
}
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phụ lục Tra cứu (Hệ SI, Hằng số, Bảng đổi) — {book.title} | Cuna Physics</title>
  <link rel="icon" type="image/png" href={`${baseUrl}/assets/mascot/sadness_yawn.png`} />
  <link rel="stylesheet" href={`${baseUrl}/vendor/katex/katex.min.css`} />
  <script is:inline>
    try {
      const raw = localStorage.getItem('cuna_preferences_v1');
      if (raw && JSON.parse(raw).theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch (e) {}
  </script>
</head>
<body class="standalone-viewer-body">
  <header class="standalone-toolbar">
    <div class="tool-left">
      <a href={`${baseUrl}/books/${book.slug}/`} class="tool-btn">
        ← Về danh mục sách
      </a>
      <h3 class="standalone-title">Phụ lục Tra cứu Toàn diện (Hệ SI, Bảng đổi, Hằng số)</h3>
    </div>
    <div class="tool-right">
      <a href={pdfUrl} target="_blank" class="tool-btn" title="Tải file PDF gốc">Bản PDF gốc</a>
    </div>
  </header>

  <main class="standalone-main">
    <div class="standalone-content-container">
      <article class="appendix-document-prose" set:html={appendixHtml} />
    </div>
  </main>

  <script defer src={`${baseUrl}/vendor/katex/katex.min.js`}></script>
  <script is:inline>
    function renderMath() {
      if (typeof katex === 'undefined') {
        setTimeout(renderMath, 50);
        return;
      }
      document.querySelectorAll('span.math.inline').forEach(el => {
        try { katex.render(el.textContent, el, { throwOnError: false, displayMode: false }); } catch (e) {}
      });
      document.querySelectorAll('span.math.display').forEach(el => {
        try { katex.render(el.textContent, el, { throwOnError: false, displayMode: true }); } catch (e) {}
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMath);
    } else {
      renderMath();
    }
  </script>

  <style>
    .standalone-viewer-body {
      margin: 0;
      padding: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
    }
    .standalone-toolbar {
      height: 52px;
      padding: 0 1.5rem;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .tool-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .standalone-title {
      margin: 0;
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--accent);
    }
    .tool-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      font-size: 0.8125rem;
      color: var(--text-main);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0.375rem;
      text-decoration: none;
    }
    .standalone-main {
      flex: 1;
      overflow-y: auto;
      padding: 2.5rem 1.5rem;
    }
    .standalone-content-container {
      max-width: 860px;
      margin: 0 auto;
      background: var(--bg-card);
      padding: 2.5rem;
      border-radius: 1rem;
      border: 1px solid var(--border-color);
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    .appendix-document-prose {
      font-size: 1rem;
      line-height: 1.75;
    }
    .appendix-document-prose h1, .appendix-document-prose h2 {
      color: var(--accent);
      margin-top: 2rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    .appendix-document-prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.9375rem;
    }
    .appendix-document-prose th, .appendix-document-prose td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--border-color);
    }
    .appendix-document-prose th {
      background: var(--bg-secondary);
    }
  </style>
</body>
</html>
