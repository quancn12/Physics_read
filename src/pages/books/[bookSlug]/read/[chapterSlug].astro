---
import fs from 'node:fs';
import path from 'node:path';
import { getBookMetadata } from '../../../../utils/books';
import '../../../../styles/global.css';

export function getStaticPaths() {
  const book = getBookMetadata('co-so-vat-ly-tap-1');
  return book.chapters.map((ch, idx) => ({
    params: {
      bookSlug: book.slug,
      chapterSlug: ch.slug
    },
    props: {
      book,
      chapter: ch,
      prevChapter: idx > 0 ? book.chapters[idx - 1] : null,
      nextChapter: idx < book.chapters.length - 1 ? book.chapters[idx + 1] : null
    }
  }));
}

const { book, chapter, prevChapter, nextChapter } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Load pre-exported chapter HTML
const htmlFilePath = path.resolve(`./src/content/chapters/${chapter.slug}.html`);
let chapterHtml = '';
if (fs.existsSync(htmlFilePath)) {
  chapterHtml = fs.readFileSync(htmlFilePath, 'utf-8');
}

// Load TOC manifest for this chapter
const tocManifestPath = path.resolve('./src/content/chapters/toc_manifest.json');
let chapterToc = [];
if (fs.existsSync(tocManifestPath)) {
  try {
    const allToc = JSON.parse(fs.readFileSync(tocManifestPath, 'utf-8'));
    chapterToc = allToc[chapter.slug] || [];
  } catch (e) {}
}

// Load answers for this chapter
const answersMapPath = path.resolve('./src/content/chapters/answers_by_chapter.json');
let chapterAnswersHtml = '';
if (fs.existsSync(answersMapPath)) {
  try {
    const allAnswers = JSON.parse(fs.readFileSync(answersMapPath, 'utf-8'));
    chapterAnswersHtml = allAnswers[chapter.number] || allAnswers[String(chapter.number)] || '';
  } catch (e) {}
}

// Load Appendix (Phụ lục) HTML
const phuLucFilePath = path.resolve('./src/content/chapters/phu-luc.html');
let phuLucHtml = '';
if (fs.existsSync(phuLucFilePath)) {
  phuLucHtml = fs.readFileSync(phuLucFilePath, 'utf-8');
}

const pdfDownloadUrl = `${baseUrl}/books/${book.slug}/pdf/${chapter.fileName}`;
const pageTitle = `Chương ${chapter.number}: ${chapter.title} — ${book.title} | Cuna Physics`;
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href={`${baseUrl}/assets/mascot/sadness_yawn.png`} />

  <!-- KaTeX CSS for math formulas -->
  <link rel="stylesheet" href={`${baseUrl}/vendor/katex/katex.min.css`} />

  <script is:inline>
    try {
      const raw = localStorage.getItem('cuna_preferences_v1');
      if (raw && JSON.parse(raw).theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch (e) {}
  </script>
</head>
<body class="reader-body">

  <!-- TOP COMPACT TOOLBAR -->
  <header class="reader-toolbar">
    <div class="toolbar-left">
      <!-- Back to Book -->
      <a href={`${baseUrl}/books/${book.slug}/`} class="tool-btn" title="Về trang mục lục sách">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span class="btn-text-hide-sm">Mục lục</span>
      </a>

      <!-- Toggle Left Sidebar (TOC) -->
      <button id="toggle-toc-btn" class="tool-btn active-pill" title="Bật/Tắt mục lục (Phím [ )">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span class="btn-text-hide-sm">Mục lục</span>
        <kbd class="shortcut-hint">[</kbd>
      </button>

      <!-- Chapter Title -->
      <div class="toolbar-chapter-title">
        <span class="badge-ch-num">Ch. {chapter.number}</span>
        <span class="ch-name-text">{chapter.title}</span>
      </div>
    </div>

    <!-- Font Size & Reading Mode Controls -->
    <div class="toolbar-center">
      <div class="font-controls">
        <button id="font-dec-btn" class="icon-tool" title="Giảm cỡ chữ (A-)">A−</button>
        <span id="font-size-indicator" class="font-indicator">100%</span>
        <button id="font-inc-btn" class="icon-tool" title="Tăng cỡ chữ (A+)">A+</button>
      </div>
    </div>

    <div class="toolbar-right">
      <!-- Search Trigger -->
      <a href={`${baseUrl}/books/${book.slug}/`} class="tool-btn" title="Tìm kiếm">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Toggle Right Sidebar (Appendix / Phụ lục) -->
      <button id="toggle-phuluc-btn" class="tool-btn" title="Bật/Tắt Phụ lục tra cứu (Phím P)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span class="btn-text-hide-sm">Phụ lục</span>
        <kbd class="shortcut-hint">P</kbd>
      </button>

      <!-- Toggle Right Sidebar (Answers) -->
      <button id="toggle-answers-btn" class="tool-btn active-pill" title="Bật/Tắt tra cứu đáp án (Phím ] )">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
        </svg>
        <span class="btn-text-hide-sm">Đáp án</span>
        <kbd class="shortcut-hint">]</kbd>
      </button>

      <!-- Theme Toggle -->
      <button id="reader-theme-toggle" class="icon-tool" title="Đổi giao diện Sáng / Tối">
        <span class="theme-icon">🌓</span>
      </button>
    </div>
  </header>

  <!-- 3-PANE READER WORKSPACE -->
  <div class="reader-layout" id="reader-layout">

    <!-- MOBILE BACKDROP -->
    <div id="mobile-backdrop" class="mobile-backdrop"></div>

    <!-- LEFT PANE: TABLE OF CONTENTS -->
    <aside class="toc-sidebar" id="toc-sidebar">
      <div class="sidebar-header">
        <div class="sidebar-title-group">
          <span class="sidebar-tag">Mục lục chương {chapter.number}</span>
          <h4 class="sidebar-heading">Đề mục chi tiết</h4>
        </div>
        <div class="sidebar-header-btns">
          <button id="close-toc-btn" class="close-panel-btn" title="Đóng">✕</button>
        </div>
      </div>

      <!-- Chapter Quick Switcher -->
      <div class="ch-switcher-box">
        <label for="ch-select">Chuyển chương:</label>
        <select id="ch-select" onchange="window.location.href=this.value;">
          {book.chapters.map((c) => (
            <option 
              value={`${baseUrl}/books/${book.slug}/read/${c.slug}/`}
              selected={c.slug === chapter.slug}
            >
              Chương {c.number}: {c.title}
            </option>
          ))}
        </select>
      </div>

      <!-- TOC Tree -->
      <nav class="toc-nav-tree" id="toc-nav-tree">
        {chapterToc.map((item) => (
          <a 
            href={item.id ? `#${item.id}` : '#'} 
            class={`toc-tree-link level-${item.level}`}
            data-target={item.id}
          >
            {item.level === 'h1' && <span class="toc-icon">📚</span>}
            {item.level === 'h2' && <span class="toc-icon">§</span>}
            {item.level === 'h3' && <span class="toc-icon">•</span>}
            {item.level === 'h4' && <span class="toc-icon">›</span>}
            <span class="toc-title-text">{item.title}</span>
          </a>
        ))}
      </nav>

      <!-- Mascot helper footer -->
      <div class="sidebar-mascot-box">
        <img src={`${baseUrl}/assets/mascot/sadness_standing.png`} alt="Sadness" class="sidebar-mascot-img" />
        <p class="sidebar-mascot-tip">Bấm vào bất kỳ đề mục nào để nhảy nhanh đến đoạn đó nha!</p>
      </div>
    </aside>

    <!-- MIDDLE PANE: NATIVE WEB DOCUMENT READER -->
    <main class="native-article-main" id="native-article-main">
      <div class="article-scroll-container" id="article-scroll-container">
        
        <!-- Chapter Header Banner -->
        <header class="chapter-document-header">
          <div class="chapter-badge-chip">CƠ SỞ VẬT LÝ TẬP 1 • CHƯƠNG {chapter.number}</div>
          <h1 class="chapter-main-heading">{chapter.title}</h1>
          {chapter.titleEn && <p class="chapter-english-title">{chapter.titleEn}</p>}
          <div class="chapter-meta-bar">
            <span>📖 Khoảng {chapter.pageCount} trang tài liệu</span>
            <span>⚡ Tải tức thì dạng Web Native</span>
            <span>✨ Công thức KaTeX sắc nét</span>
          </div>
        </header>

        <!-- Chapter Content Rendered directly from HTML -->
        <article class="book-article-prose" id="book-article-prose" set:html={chapterHtml} />

        <!-- Bottom Navigation -->
        <footer class="chapter-footer-nav">
          <div class="nav-links-row">
            {prevChapter ? (
              <a href={`${baseUrl}/books/${book.slug}/read/${prevChapter.slug}/`} class="ch-nav-card prev-card">
                <span class="card-direction">← Chương trước</span>
                <span class="card-title">Chương {prevChapter.number}: {prevChapter.title}</span>
              </a>
            ) : <div />}

            {nextChapter && (
              <a href={`${baseUrl}/books/${book.slug}/read/${nextChapter.slug}/`} class="ch-nav-card next-card">
                <span class="card-direction">Chương tiếp theo →</span>
                <span class="card-title">Chương {nextChapter.number}: {nextChapter.title}</span>
              </a>
            )}
          </div>

          <div class="chapter-encouragement">
            <img src={`${baseUrl}/assets/mascot/sadness_io2.png`} alt="Sadness" class="encouragement-img" />
            <div class="encouragement-text">
              <p class="quote">"Học xong một chương là đã tiến một bước dài rồi đó Cuna ơi..."</p>
              <p class="sub">Nghỉ ngơi một chút rồi sang chương tiếp theo nhé!</p>
            </div>
          </div>
        </footer>

      </div>
    </main>

    <!-- RIGHT PANE: REFERENCE COLUMN (ANSWERS & APPENDIX) -->
    <aside class="answers-sidebar" id="answers-sidebar">
      <div class="resize-handle" id="answers-resize-handle" title="Kéo để chỉnh độ rộng"></div>
      
      <div class="sidebar-header">
        <div class="sidebar-tab-pills">
          <button id="tab-btn-answers" class="tab-pill active" title="Xem Đáp án bài tập">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
            </svg>
            <span>Đáp án Ch.{chapter.number}</span>
          </button>
          <button id="tab-btn-phuluc" class="tab-pill" title="Xem Phụ lục tra cứu">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Phụ lục tra cứu</span>
          </button>
        </div>
        <div class="sidebar-header-btns">
          <a id="sidebar-external-btn" href={`${baseUrl}/books/${book.slug}/dap-an/`} target="_blank" class="icon-tool" title="Mở trang toàn bộ riêng">↗</a>
          <button id="close-answers-btn" class="close-panel-btn" title="Đóng bảng">✕</button>
        </div>
      </div>

      <!-- Tab Content 1: Answers -->
      <div class="answers-content-scroll tab-pane" id="tab-pane-answers">
        {chapterAnswersHtml ? (
          <div class="answers-body-prose" set:html={chapterAnswersHtml} />
        ) : (
          <div class="answers-empty-state">
            <img src={`${baseUrl}/assets/mascot/sadness_yawn.png`} alt="Sadness" class="empty-mascot-img" />
            <p>Chương này không có phần bài tập riêng.</p>
            <a href={`${baseUrl}/books/${book.slug}/dap-an/`} class="btn-subtle">Xem toàn bộ phụ lục đáp án</a>
          </div>
        )}
      </div>

      <!-- Tab Content 2: Appendix -->
      <div class="answers-content-scroll tab-pane" id="tab-pane-phuluc" style="display: none;">
        <div class="phuluc-quick-nav">
          <div class="phuluc-chips-row">
            <a href="#phụ-lục-a" class="phuluc-chip">A. Hệ SI</a>
            <a href="#phụ-lục-b" class="phuluc-chip">B. Hằng số</a>
            <a href="#phụ-lục-c" class="phuluc-chip">C. Thiên văn</a>
            <a href="#phụ-lục-d" class="phuluc-chip">D. Đổi đơn vị</a>
            <a href="#phụ-lục-e" class="phuluc-chip">E. Toán học</a>
          </div>
        </div>
        {phuLucHtml ? (
          <div class="phuluc-body-prose answers-body-prose" set:html={phuLucHtml} />
        ) : (
          <div class="answers-empty-state">
            <p>Không tìm thấy nội dung phụ lục.</p>
          </div>
        )}
      </div>
    </aside>

  </div>

  <!-- KaTeX JavaScript -->
  <script defer src={`${baseUrl}/vendor/katex/katex.min.js`}></script>

  <!-- Client-side Interactive Logic -->
  <script is:inline>
    // 1. Math Rendering with KaTeX
    function renderMathFormulas() {
      if (typeof katex === 'undefined') {
        setTimeout(renderMathFormulas, 50);
        return;
      }
      document.querySelectorAll('span.math.inline').forEach(el => {
        try {
          katex.render(el.textContent, el, { throwOnError: false, displayMode: false });
        } catch (e) {}
      });
      document.querySelectorAll('span.math.display').forEach(el => {
        try {
          katex.render(el.textContent, el, { throwOnError: false, displayMode: true });
        } catch (e) {}
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMathFormulas);
    } else {
      renderMathFormulas();
    }

    // 2. Font Size Scaling
    const proseEl = document.getElementById('book-article-prose');
    const indicatorEl = document.getElementById('font-size-indicator');
    let currentScale = 100;

    try {
      const savedScale = localStorage.getItem('cuna_font_scale');
      if (savedScale) {
        currentScale = parseInt(savedScale, 10);
        applyScale();
      }
    } catch (e) {}

    function applyScale() {
      if (proseEl) {
        proseEl.style.fontSize = (17 * currentScale / 100) + 'px';
      }
      if (indicatorEl) {
        indicatorEl.textContent = currentScale + '%';
      }
      try {
        localStorage.setItem('cuna_font_scale', currentScale);
      } catch (e) {}
    }

    document.getElementById('font-inc-btn')?.addEventListener('click', () => {
      if (currentScale < 160) {
        currentScale += 10;
        applyScale();
      }
    });

    document.getElementById('font-dec-btn')?.addEventListener('click', () => {
      if (currentScale > 70) {
        currentScale -= 10;
        applyScale();
      }
    });

    // 3. Theme Toggle
    document.getElementById('reader-theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      try {
        const pref = JSON.parse(localStorage.getItem('cuna_preferences_v1') || '{}');
        pref.theme = newTheme;
        localStorage.setItem('cuna_preferences_v1', JSON.stringify(pref));
      } catch (e) {}
    });

    // 4. Panel Toggles
    const tocSidebar = document.getElementById('toc-sidebar');
    const answersSidebar = document.getElementById('answers-sidebar');
    const backdrop = document.getElementById('mobile-backdrop');

    function closeAllMobileDrawers() {
      tocSidebar?.classList.remove('open');
      answersSidebar?.classList.remove('open');
      backdrop?.classList.remove('active');
    }

    backdrop?.addEventListener('click', closeAllMobileDrawers);

    document.getElementById('toggle-toc-btn')?.addEventListener('click', () => {
      if (window.innerWidth <= 1024) {
        const isOpen = tocSidebar?.classList.contains('open');
        closeAllMobileDrawers();
        if (!isOpen) {
          tocSidebar?.classList.add('open');
          backdrop?.classList.add('active');
        }
      } else {
        tocSidebar?.classList.toggle('closed');
      }
    });

    document.getElementById('close-toc-btn')?.addEventListener('click', () => {
      if (window.innerWidth <= 1024) {
        closeAllMobileDrawers();
      } else {
        tocSidebar?.classList.add('closed');
      }
    });

    // 4. Right Sidebar: Tabs & Toggle (Answers & Appendix)
    const tabBtnAnswers = document.getElementById('tab-btn-answers');
    const tabBtnPhuLuc = document.getElementById('tab-btn-phuluc');
    const tabPaneAnswers = document.getElementById('tab-pane-answers');
    const tabPanePhuLuc = document.getElementById('tab-pane-phuluc');
    const toggleAnswersBtn = document.getElementById('toggle-answers-btn');
    const togglePhuLucBtn = document.getElementById('toggle-phuluc-btn');
    const externalLinkBtn = document.getElementById('sidebar-external-btn');

    function switchRightTab(tab) {
      if (tab === 'answers') {
        tabBtnAnswers?.classList.add('active');
        tabBtnPhuLuc?.classList.remove('active');
        if (tabPaneAnswers) tabPaneAnswers.style.display = 'block';
        if (tabPanePhuLuc) tabPanePhuLuc.style.display = 'none';
        if (externalLinkBtn) {
          externalLinkBtn.href = `${baseUrl}/books/${book.slug}/dap-an/`;
          externalLinkBtn.title = 'Mở toàn bộ đáp án';
        }
        toggleAnswersBtn?.classList.add('active-pill');
        togglePhuLucBtn?.classList.remove('active-pill');
      } else {
        tabBtnPhuLuc?.classList.add('active');
        tabBtnAnswers?.classList.remove('active');
        if (tabPanePhuLuc) tabPanePhuLuc.style.display = 'block';
        if (tabPaneAnswers) tabPaneAnswers.style.display = 'none';
        if (externalLinkBtn) {
          externalLinkBtn.href = `${baseUrl}/books/${book.slug}/phu-luc/`;
          externalLinkBtn.title = 'Mở toàn bộ phụ lục tra cứu';
        }
        togglePhuLucBtn?.classList.add('active-pill');
        toggleAnswersBtn?.classList.remove('active-pill');
      }
    }

    tabBtnAnswers?.addEventListener('click', () => switchRightTab('answers'));
    tabBtnPhuLuc?.addEventListener('click', () => switchRightTab('phuluc'));

    if (window.location.hash === '#phuluc' || window.location.search.includes('tab=phuluc')) {
      switchRightTab('phuluc');
    }

    toggleAnswersBtn?.addEventListener('click', () => {
      const isMobile = window.innerWidth <= 1024;
      const isOpen = isMobile ? answersSidebar?.classList.contains('open') : !answersSidebar?.classList.contains('closed');
      const isCurrentTab = tabBtnAnswers?.classList.contains('active');

      if (!isOpen) {
        if (isMobile) {
          closeAllMobileDrawers();
          answersSidebar?.classList.add('open');
          backdrop?.classList.add('active');
        } else {
          answersSidebar?.classList.remove('closed');
        }
        switchRightTab('answers');
      } else if (isCurrentTab) {
        if (isMobile) {
          closeAllMobileDrawers();
        } else {
          answersSidebar?.classList.add('closed');
          toggleAnswersBtn?.classList.remove('active-pill');
        }
      } else {
        switchRightTab('answers');
      }
    });

    togglePhuLucBtn?.addEventListener('click', () => {
      const isMobile = window.innerWidth <= 1024;
      const isOpen = isMobile ? answersSidebar?.classList.contains('open') : !answersSidebar?.classList.contains('closed');
      const isCurrentTab = tabBtnPhuLuc?.classList.contains('active');

      if (!isOpen) {
        if (isMobile) {
          closeAllMobileDrawers();
          answersSidebar?.classList.add('open');
          backdrop?.classList.add('active');
        } else {
          answersSidebar?.classList.remove('closed');
        }
        switchRightTab('phuluc');
      } else if (isCurrentTab) {
        if (isMobile) {
          closeAllMobileDrawers();
        } else {
          answersSidebar?.classList.add('closed');
          togglePhuLucBtn?.classList.remove('active-pill');
        }
      } else {
        switchRightTab('phuluc');
      }
    });

    document.getElementById('close-answers-btn')?.addEventListener('click', () => {
      if (window.innerWidth <= 1024) {
        closeAllMobileDrawers();
      } else {
        answersSidebar?.classList.add('closed');
        toggleAnswersBtn?.classList.remove('active-pill');
        togglePhuLucBtn?.classList.remove('active-pill');
      }
    });

    // 5. Keyboard Shortcuts: [ , ] and P
    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === '[') {
        if (window.innerWidth <= 1024) {
          tocSidebar?.classList.toggle('open');
          backdrop?.classList.toggle('active');
        } else {
          tocSidebar?.classList.toggle('closed');
        }
      } else if (e.key === ']') {
        toggleAnswersBtn?.click();
      } else if (e.key === 'p' || e.key === 'P') {
        togglePhuLucBtn?.click();
      }
    });

    // 6. Smooth Scroll on TOC Click
    document.querySelectorAll('.toc-tree-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-target');
        if (targetId) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `#${targetId}`);
            document.querySelectorAll('.toc-tree-link').forEach(l => l.classList.remove('active'));
            link.classList.add('active');
            if (window.innerWidth <= 1024) {
              closeAllMobileDrawers();
            }
          }
        }
      });
    });

    // 7. Resizable Answers Panel (Desktop only)
    const resizeHandle = document.getElementById('answers-resize-handle');
    if (resizeHandle && answersSidebar) {
      let isResizing = false;
      resizeHandle.addEventListener('mousedown', (e) => {
        if (window.innerWidth <= 1024) return;
        isResizing = true;
        document.body.style.userSelect = 'none';
      });
      window.addEventListener('mousemove', (e) => {
        if (!isResizing) return;
        const newWidth = window.innerWidth - e.clientX;
        if (newWidth > 260 && newWidth < 650) {
          answersSidebar.style.width = `${newWidth}px`;
        }
      });
      window.addEventListener('mouseup', () => {
        if (isResizing) {
          isResizing = false;
          document.body.style.userSelect = '';
        }
      });
    }
