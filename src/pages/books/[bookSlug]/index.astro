---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBookMetadata } from '../../../utils/books';

export function getStaticPaths() {
  return [
    { params: { bookSlug: 'co-so-vat-ly-tap-1' } }
  ];
}

const { bookSlug } = Astro.params;
const book = getBookMetadata(bookSlug);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Gán độ khó tham khảo cho từng chương (thang điểm 1-5)
const DIFFICULTY_MAP: Record<number, number> = {
  1: 1, 2: 2, 3: 2, 4: 3, 5: 3, 6: 4, 7: 3, 8: 4, 9: 4, 10: 4,
  11: 5, 12: 3, 13: 4, 14: 3, 15: 4, 16: 4, 17: 4, 18: 3, 19: 4, 20: 5
};

const CHAPTER_DESCS: Record<number, string> = {
  1: "Hệ đo lường quốc tế SI, đổi đơn vị và xử lý sai số chữ số có nghĩa trong thực nghiệm vật lý.",
  2: "Toạ độ, vận tốc, gia tốc, chuyển động biến đổi đều và phân tích chuyển động rơi tự do.",
  3: "Đại số vectơ: Phép cộng trừ vectơ hình học, toạ độ Descartes, tích vô hướng và tích có hướng.",
  4: "Vectơ vị trí và vận tốc trong không gian, chuyển động ném xiên và chuyển động tròn đều.",
  5: "Ba định luật Newton kinh điển, khái niệm lực tác dụng và phương pháp giải bài toán cơ học.",
  6: "Lực ma sát trượt, ma sát nghỉ, lực cản của môi trường và chuyển động tròn có gia tốc hướng tâm.",
  7: "Công cơ học của lực không đổi và biến thiên, định lý động năng và công suất.",
  8: "Thế năng trọng trường và đàn hồi, định luật bảo toàn cơ năng và lực thế / lực phi thế.",
  9: "Khối tâm của hệ chất điểm và vật rắn, xung lượng, định luật bảo toàn động lượng tuyến tính và va chạm.",
  10: "Toạ độ góc, tốc độ góc, mômen quán tính, định lý trục song song và động năng quay.",
  11: "Chuyển động lăn không trượt, mômen lực vectơ, định luật bảo toàn mômen động lượng và hiện tượng hồi chuyển.",
  12: "Điều kiện cân bằng tĩnh của vật rắn (tổng lực và tổng mômen triệt tiêu), ứng suất và biến dạng đàn hồi.",
  13: "Định luật vạn vật hấp dẫn Newton, thế năng hấp dẫn, các định luật Kepler và chuyển động của hành tinh / vệ tinh.",
  14: "Áp suất thuỷ tĩnh, định luật Pascal, lực đẩy Archimedes, phương trình liên tục và định luật Bernoulli.",
  15: "Dao động điều hoà, con lắc đơn, con lắc vật lý, dao động tắt dần và hiện tượng cộng hưởng cơ học.",
  16: "Phương trình sóng lan truyền, tốc độ sóng trên dây, giao thoa sóng và sóng dừng.",
  17: "Sóng âm trong chất khí, cường độ âm và mức cường độ âm (Decibel), hiệu ứng Doppler trong âm học.",
  18: "Thang đo nhiệt độ Celsius / Kelvin, sự nở vì nhiệt, nhiệt dung riêng, công của chất khí và Định luật 1 NĐLH.",
  19: "Mô hình khí lý tưởng, áp suất phân tử, căn bậc hai vận tốc trung bình (v_rms), bậc tự do và định luật phân bố năng lượng.",
  20: "Quá trình thuận nghịch và không thuận nghịch, động cơ nhiệt Carnot, khái niệm Entropy và Định luật 2 NĐLH."
};
---

<BaseLayout 
  title={`${book.title} — Mục Lục 20 Chương | Cuna Physics`}
  description={book.description}
  currentPath={`/books/${book.slug}/`}
>
  <!-- BOOK HEADER OVERVIEW -->
  <section class="book-header-section">
    <div class="container book-header-grid">
      <!-- Book Cover Visual -->
      <div class="book-cover-col">
        <div class="cover-canvas">
          <span class="cover-tag">TẬP 1</span>
          <h2 class="cover-title">CƠ SỞ VẬT LÝ</h2>
          <p class="cover-sub">Cơ học • Sóng • Nhiệt động lực học</p>
          <div class="cover-authors">D. Halliday • R. Resnick • J. Walker</div>
        </div>
      </div>

      <!-- Book Info & Quick Actions -->
      <div class="book-info-col">
        <div class="book-badges">
          <span class="badge-blue">Olympic SPhO / VPhO</span>
          <span class="badge-gray">{book.totalChapters} Chương</span>
          <span class="badge-gray">{book.totalPages} Trang PDF</span>
        </div>

        <h1 class="book-h1">{book.title}</h1>
        <p class="book-lead">{book.description}</p>

        <!-- Book Progress Indicator -->
        <div class="book-prog-card">
          <div class="prog-meta">
            <span class="prog-label">Tiến độ cả cuốn của bạn</span>
            <span id="page-stat-badge" class="prog-val">0% (0 / {book.totalPages} trang)</span>
          </div>
          <div class="prog-bar-bg">
            <div id="book-prog-bar-fill" class="prog-bar-fill" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Quick Access to Appendix, Answers, TOC -->
        <div class="quick-access-box">
          <span class="quick-label">Lối vào tra cứu nhanh:</span>
          <div class="quick-links">
            <a href={`${baseUrl}/books/${book.slug}/dap-an/`} class="quick-btn">
              <span>🔑</span> Đáp án chung (11 tr)
            </a>
            <a href={`${baseUrl}/books/${book.slug}/phu-luc/`} class="quick-btn">
              <span>📑</span> Phụ lục A – G (17 tr)
            </a>
            <a href={`${baseUrl}/books/${book.slug}/pdf/00-muc-luc.pdf`} target="_blank" class="quick-btn">
              <span>📜</span> Mục lục gốc (PDF)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTERS GRID -->
  <section class="chapters-section">
    <div class="container">
      <div class="chapters-header">
        <div>
          <span class="chapters-tag">Chi tiết từng chuyên đề</span>
          <h2 class="chapters-title">Danh sách 20 Chương</h2>
        </div>
        <p class="chapters-hint">Bấm vào từng thẻ chương để xem cây mục lục chi tiết và bắt đầu đọc</p>
      </div>

      <div class="chapters-list">
        {book.chapters.map((ch) => {
          const diffStars = DIFFICULTY_MAP[ch.number] || 3;
          const desc = CHAPTER_DESCS[ch.number] || '';

          return (
            <div class="ch-card" data-chapter-slug={ch.slug} data-chapter-num={ch.number} data-total-pages={ch.pageCount}>
              <!-- Card Header -->
              <div class="ch-card-header" onclick={`toggleAccordion('${ch.slug}')`}>
                <div class="ch-num-badge">
                  {ch.number < 10 ? `0${ch.number}` : ch.number}
                </div>

                <div class="ch-main-info">
                  <div class="ch-meta-row">
                    <span class="ch-en-title">{ch.titleEn}</span>
                    <span class="ch-pages-count">{ch.pageCount} trang</span>
                    <div class="diff-dots" title={`Độ khó: ${diffStars}/5`}>
                      {[1, 2, 3, 4, 5].map((s) => (
                        <span class={`dot ${s <= diffStars ? 'filled' : ''}`}></span>
                      ))}
                    </div>
                  </div>

                  <h3 class="ch-title">{ch.title}</h3>
                  <p class="ch-desc">{desc}</p>
                </div>

                <div class="ch-actions-right">
                  <span class="status-badge status-unread" id={`status-${ch.slug}`}>Chưa đọc</span>
                  <button class="accordion-arrow" title="Mở rộng mục con">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Accordion Body: Section Tree & Read Buttons -->
              <div class="ch-accordion-content" id={`accordion-${ch.slug}`} style="display: none;">
                <div class="accordion-inner">
                  <!-- Section Tree -->
                  <div class="sections-tree">
                    <span class="tree-heading">Cây mục lục chương {ch.number}:</span>
                    {ch.sections && ch.sections.length > 0 ? (
                      <ul class="sec-list">
                        {ch.sections.map((sec) => (
                          <li class="sec-item">
                            <a 
                              href={`${baseUrl}/books/${book.slug}/read/${ch.slug}/?page=${sec.pdf_page}`}
                              class="sec-link"
                            >
                              <span class="sec-code">{sec.code}</span>
                              <span class="sec-name">{sec.title}</span>
                              <span class="sec-pg">tr. {sec.pdf_page}</span>
                            </a>

                            {sec.subsections && sec.subsections.length > 0 && (
                              <ul class="subsec-list">
                                {sec.subsections.map((sub) => (
                                  <li class="subsec-item">
                                    <a 
                                      href={`${baseUrl}/books/${book.slug}/read/${ch.slug}/?page=${sub.pdf_page}`}
                                      class="subsec-link"
                                    >
                                      <span class="subsec-bullet">•</span>
                                      <span class="subsec-name">{sub.title}</span>
                                      <span class="subsec-pg">tr. {sub.pdf_page}</span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="no-sec-hint">Nhấp vào "Đọc chương này" để mở tài liệu PDF.</p>
                    )}
                  </div>

                  <!-- Quick Action Buttons -->
                  <div class="ch-bottom-actions">
                    <a 
                      href={`${baseUrl}/books/${book.slug}/read/${ch.slug}/?page=1`} 
                      class="btn-primary"
                    >
                      Đọc từ đầu (Trang 1) →
                    </a>
                    <a 
                      id={`btn-resume-${ch.slug}`}
                      href={`${baseUrl}/books/${book.slug}/read/${ch.slug}/?page=1`} 
                      class="btn-secondary"
                    >
                      Đọc tiếp
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* BOOK HEADER */
  .book-header-section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  .book-header-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .book-header-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }
  }

  .cover-canvas {
    background: linear-gradient(145deg, #1E3A8A 0%, #1D4ED8 50%, #2563EB 100%);
    border-radius: var(--radius-lg);
    aspect-ratio: 3/4;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #FFFFFF;
    box-shadow: 0 16px 36px -8px rgba(30, 58, 138, 0.45);
  }
  .cover-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #93C5FD;
  }
  .cover-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-top: auto;
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }
  .cover-sub {
    font-size: 0.72rem;
    color: #BFDBFE;
    margin-bottom: 0.75rem;
  }
  .cover-authors {
    font-size: 0.65rem;
    color: #93C5FD;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 0.5rem;
  }

  .book-info-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .book-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .book-badges { justify-content: center; }
  }
  .badge-blue {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .badge-gray {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .book-h1 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .book-lead {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* PROGRESS CARD */
  .book-prog-card {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }
  .prog-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .prog-label { color: var(--text-secondary); }
  .prog-val { color: var(--primary); }
  .prog-bar-bg {
    height: 8px;
    background: var(--bg-subtle);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .prog-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, #0284C7 100%);
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  /* QUICK ACCESS */
  .quick-access-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  @media (max-width: 768px) {
    .quick-access-box { justify-content: center; }
  }
  .quick-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .quick-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .quick-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-light);
  }

  /* CHAPTERS SECTION */
  .chapters-section {
    padding: 3.5rem 0 5rem;
  }
  .chapters-header {
    margin-bottom: 2rem;
  }
  .chapters-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .chapters-title {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.2rem 0;
  }
  .chapters-hint {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .chapters-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* CHAPTER CARD */
  .ch-card {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .ch-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-sm);
  }

  .ch-card-header {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 1.5rem;
    padding: 1.5rem;
    cursor: pointer;
    align-items: center;
    user-select: none;
  }
  @media (max-width: 640px) {
    .ch-card-header {
      grid-template-columns: 44px 1fr;
      gap: 1rem;
    }
  }

  .ch-num-badge {
    width: 52px;
    height: 52px;
    background: var(--primary-light);
    border: 1.5px solid var(--primary-border);
    color: var(--primary);
    font-size: 1.3rem;
    font-weight: 800;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 640px) {
    .ch-num-badge {
      width: 44px;
      height: 44px;
      font-size: 1.1rem;
    }
  }

  .ch-main-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .ch-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
  }
  .ch-en-title {
    font-weight: 700;
    color: var(--primary);
  }
  .ch-pages-count {
    color: var(--text-muted);
  }

  .diff-dots {
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }
  .diff-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-color);
  }
  .diff-dots .dot.filled {
    background: var(--accent-gold);
  }

  .ch-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .ch-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .ch-actions-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .ch-actions-right {
      grid-column: 2;
      justify-content: space-between;
      margin-top: 0.5rem;
    }
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }
  .status-unread {
    background: var(--bg-subtle);
    color: var(--text-muted);
  }
  .status-reading {
    background: #FEF3C7;
    color: #D97706;
  }
  .status-done {
    background: #D1FAE5;
    color: #059669;
  }

  .accordion-arrow {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .ch-card.open .accordion-arrow {
    transform: rotate(180deg);
    color: var(--primary);
  }

  /* ACCORDION CONTENT */
  .ch-accordion-content {
    border-top: 1px solid var(--border-color);
    background: var(--bg-subtle);
  }
  .accordion-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tree-heading {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }
  .sec-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sec-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sec-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .sec-link:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateX(3px);
  }
  .sec-code {
    font-weight: 800;
    color: var(--primary);
    min-width: 32px;
  }
  .sec-name { flex: 1; }
  .sec-pg {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .subsec-list {
    list-style: none;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .subsec-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  .subsec-link:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.06);
  }
  .subsec-bullet { color: var(--primary); }
  .subsec-name { flex: 1; }
  .subsec-pg { font-size: 0.75rem; color: var(--text-muted); }

  .ch-bottom-actions {
    display: flex;
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  function toggleAccordion(slug) {
    const el = document.getElementById(`accordion-${slug}`);
    const card = el?.closest('.ch-card');
    if (!el || !card) return;
    const isHidden = el.style.display === 'none';
    el.style.display = isHidden ? 'block' : 'none';
    if (isHidden) {
      card.classList.add('open');
    } else {
      card.classList.remove('open');
    }
  }
</script>

<script>
  import { getChapterProgress } from '../../../utils/storage';

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
  const cards = document.querySelectorAll('.ch-card');
  let totalBookReadPages = 0;
  let totalBookPages = 1023;

  cards.forEach((card) => {
    const slug = card.getAttribute('data-chapter-slug');
    const totalPages = parseInt(card.getAttribute('data-total-pages') || '1', 10);
    if (!slug) return;

    const prog = getChapterProgress('co-so-vat-ly-tap-1', slug);
    const statusEl = document.getElementById(`status-${slug}`);
    const resumeBtn = document.getElementById(`btn-resume-${slug}`) as HTMLAnchorElement;

    if (prog) {
      totalBookReadPages += prog.readPages.length;

      if (prog.isCompleted) {
        if (statusEl) {
          statusEl.textContent = 'Đã đọc xong ✓';
          statusEl.className = 'status-badge status-done';
        }
      } else if (prog.readPages.length > 0) {
        if (statusEl) {
          statusEl.textContent = `Đang đọc (${prog.readPages.length}/${totalPages} tr)`;
          statusEl.className = 'status-badge status-reading';
        }
      }

      if (resumeBtn && prog.lastPage > 1) {
        resumeBtn.href = `${baseUrl}/books/co-so-vat-ly-tap-1/read/${slug}/?page=${prog.lastPage}`;
        resumeBtn.textContent = `Đọc tiếp (Trang ${prog.lastPage}) →`;
      }
    }
  });

  const pct = Math.min(100, Math.round((totalBookReadPages / totalBookPages) * 100));
  const badgeEl = document.getElementById('page-stat-badge');
  const barEl = document.getElementById('book-prog-bar-fill');
  if (badgeEl) badgeEl.textContent = `${pct}% (${totalBookReadPages} / ${totalBookPages} trang)`;
  if (barEl) barEl.style.width = `${pct}%`;
</script>
