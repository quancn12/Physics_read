---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBookMetadata } from '../utils/books';

const book = getBookMetadata('co-so-vat-ly-tap-1');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Cuna Physics — Đọc Giáo Trình & Tài Liệu Vật Lý Cá Nhân" currentPath="/">
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-grid">
      <!-- Left: Mascot Presentation -->
      <div class="hero-visual">
        <div class="mascot-badge">
          <span>✨</span> Vibe Sáng & Chill Cùng Cuna
        </div>
        <div class="mascot-frame">
          <img 
            src={`${baseUrl}/assets/mascot/sadness_yawn.png`} 
            alt="Sadness Mascot Cuna" 
            class="mascot-hero-img" 
          />
        </div>
        <div class="mascot-speech">
          😴 "Oáp... Vật lý cuốn quá quên cả ngủ! Cùng Cuna mở sách nào!"
        </div>
      </div>

      <!-- Right: Welcome Text & Continue Reading Card -->
      <div class="hero-content">
        <span class="sub-badge">Tủ sách cá nhân của Cuna</span>
        <h1 class="hero-title">
          Học sâu, đọc kỹ & hiểu bản chất <span class="text-gradient">Vật lý học</span>
        </h1>
        <p class="hero-subtitle">
          Không gian đọc giáo trình tĩnh, tối ưu cho sự tập trung cá nhân. Tự động ghi nhớ từng trang đã đọc, tra cứu nhanh đáp án song song và tìm kiếm toàn văn 1023 trang sách.
        </p>

        <!-- DYNAMIC "ĐỌC TIẾP" CARD -->
        <div id="continue-card" class="continue-card">
          <div class="continue-header">
            <span class="continue-tag">Đang đọc dở</span>
            <span id="continue-time" class="continue-time">Gần đây</span>
          </div>
          <div class="continue-body">
            <div class="continue-info">
              <h4 id="continue-chapter-title">Chương 01: Đo lường</h4>
              <p id="continue-page-text">Trang 1 / 18 trang</p>
            </div>
            <a id="continue-btn" href={`${baseUrl}/books/co-so-vat-ly-tap-1/read/01-do-luong/?page=1`} class="btn-primary">
              Tiếp tục đọc →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKS LIST SECTION -->
  <section class="books-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-tag">Bộ tài liệu hiện có</span>
          <h2 class="section-title">Danh mục Giáo trình</h2>
        </div>
        <span class="books-count">1 Cuốn • 20 Chương • 1023 Trang</span>
      </div>

      <div class="books-grid">
        <!-- BOOK CARD 1 -->
        <div class="book-card">
          <div class="book-card-cover">
            <div class="cover-art">
              <div class="atom-symbol">
                <div class="nucleus"></div>
                <div class="orbit orbit-1"></div>
                <div class="orbit orbit-2"></div>
                <div class="orbit orbit-3"></div>
              </div>
              <span class="cover-vol">TẬP 1</span>
              <h3 class="cover-book-title">CƠ SỞ VẬT LÝ</h3>
              <p class="cover-book-sub">Cơ học • Sóng • Nhiệt động lực học</p>
              <span class="cover-authors">D. Halliday • R. Resnick • J. Walker</span>
            </div>
          </div>

          <div class="book-card-details">
            <div class="book-meta-top">
              <span class="badge-series">Olympic SPhO / VPhO</span>
              <span class="badge-pages">1023 Trang PDF</span>
            </div>
            <h3 class="book-name">
              <a href={`${baseUrl}/books/${book.slug}/`}>
                {book.title}
              </a>
            </h3>
            <p class="book-desc">
              {book.description}
            </p>

            <!-- Book Overall Progress Bar -->
            <div class="book-progress-box">
              <div class="progress-labels">
                <span class="prog-title">Tiến độ đọc của tôi</span>
                <span id="book-prog-percent" class="prog-pct">0%</span>
              </div>
              <div class="progress-track">
                <div id="book-prog-bar" class="progress-fill" style="width: 0%;"></div>
              </div>
            </div>

            <div class="book-card-actions">
              <a href={`${baseUrl}/books/${book.slug}/`} class="btn-primary" style="flex:1;">
                Xem danh mục 20 chương →
              </a>
              <a href={`${baseUrl}/books/${book.slug}/read/01-do-luong/?page=1`} class="btn-secondary" title="Đọc từ chương đầu">
                Đọc từ đầu
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero-section {
    padding: 3.5rem 0 4.5rem;
    position: relative;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .mascot-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--primary-light);
    border: 1px solid var(--primary-border);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }
  .mascot-frame {
    width: 250px;
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .mascot-frame::after {
    content: '';
    position: absolute;
    bottom: 5px;
    width: 140px;
    height: 14px;
    background: var(--primary-glow);
    border-radius: 50%;
    filter: blur(6px);
    z-index: 0;
  }
  .mascot-hero-img {
    width: 230px;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 15px 25px rgba(37, 99, 235, 0.25));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mascot-hero-img:hover {
    transform: translateY(-4px) scale(1.02);
  }
  .mascot-speech {
    margin-top: 1rem;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    position: relative;
    box-shadow: var(--shadow-sm);
  }
  .mascot-speech::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-bottom: 8px solid var(--bg-surface);
  }

  .sub-badge {
    display: inline-block;
    color: var(--primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }
  .hero-title {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }
  @media (max-width: 640px) {
    .hero-title { font-size: 2rem; }
  }
  .text-gradient {
    background: linear-gradient(135deg, #2563EB 0%, #0284C7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 620px;
  }
  @media (max-width: 900px) {
    .hero-subtitle { margin: 0 auto 2rem; }
  }

  /* CONTINUE READING CARD */
  .continue-card {
    background: var(--bg-surface);
    border: 2px solid var(--primary-border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 1.75rem;
    box-shadow: 0 12px 24px -6px var(--primary-glow);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .continue-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -6px var(--primary-glow);
  }
  .continue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }
  .continue-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .continue-time {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .continue-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  #continue-chapter-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }
  #continue-page-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* BOOKS LIST */
  .books-section {
    padding: 3rem 0 5rem;
    border-top: 1px solid var(--border-color);
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .section-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.25rem;
  }
  .section-title {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .books-count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .books-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* BOOK CARD */
  .book-card {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2rem;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: center;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }
  .book-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 768px) {
    .book-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* COVER ART */
  .cover-art {
    background: linear-gradient(145deg, #1E3A8A 0%, #1D4ED8 50%, #2563EB 100%);
    border-radius: var(--radius-lg);
    aspect-ratio: 3/4;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.4);
  }
  .cover-vol {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #93C5FD;
  }
  .cover-book-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-top: auto;
    margin-bottom: 0.25rem;
  }
  .cover-book-sub {
    font-size: 0.7rem;
    color: #BFDBFE;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .cover-authors {
    font-size: 0.65rem;
    color: #93C5FD;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 0.5rem;
  }

  /* ATOM ORBIT SVG */
  .atom-symbol {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
  }
  .nucleus {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #F59E0B;
    border-radius: 50%;
    top: 26px;
    left: 26px;
  }
  .orbit {
    position: absolute;
    inset: 5px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
  }
  .orbit-1 { transform: rotate(0deg); }
  .orbit-2 { transform: rotate(60deg); }
  .orbit-3 { transform: rotate(120deg); }

  /* DETAILS */
  .book-card-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .book-meta-top {
    display: flex;
    gap: 0.6rem;
  }
  .badge-series {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .badge-pages {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .book-name {
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .book-name a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .book-name a:hover {
    color: var(--primary);
  }
  .book-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .book-progress-box {
    background: var(--bg-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.1rem;
  }
  .progress-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .prog-title { color: var(--text-secondary); }
  .prog-pct { color: var(--primary); }
  .progress-track {
    height: 8px;
    background: var(--border-color);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, #0284C7 100%);
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  .book-card-actions {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
</style>

<script>
  import { getLastRead, getChapterProgress } from '../utils/storage';

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

  // 1. Cập nhật vị trí đọc gần nhất trên Card Đọc tiếp
  const lastRead = getLastRead();
  if (lastRead) {
    const titleEl = document.getElementById('continue-chapter-title');
    const pageEl = document.getElementById('continue-page-text');
    const btnEl = document.getElementById('continue-btn') as HTMLAnchorElement;
    const timeEl = document.getElementById('continue-time');

    if (titleEl && lastRead.chapterTitle) {
      titleEl.textContent = lastRead.chapterTitle;
    }
    if (pageEl) {
      pageEl.textContent = `Trang ${lastRead.page} • Đang xem dở`;
    }
    if (btnEl) {
      btnEl.href = `${baseUrl}/books/${lastRead.bookSlug}/read/${lastRead.chapterSlug}/?page=${lastRead.page}`;
      btnEl.textContent = `Tiếp tục đọc (Trang ${lastRead.page}) →`;
    }
    if (timeEl && lastRead.timestamp) {
      const diffMins = Math.round((Date.now() - lastRead.timestamp) / 60000);
      if (diffMins < 60) {
        timeEl.textContent = `${diffMins} phút trước`;
      } else {
        timeEl.textContent = `${Math.round(diffMins / 60)} giờ trước`;
      }
    }
  }

  // 2. Tính toán tổng tiến độ đọc của cuốn sách
  let totalReadPages = 0;
  const totalBookPages = 1023;
  for (let i = 1; i <= 20; i++) {
    // Check chapter prog
    const raw = localStorage.getItem(`cuna_prog_co-so-vat-ly-tap-1_ch${i}`);
    // or by slug
  }
  // Compute across localStorage keys
  try {
    const keys = Object.keys(localStorage);
    keys.forEach(k => {
      if (k.startsWith('cuna_prog_co-so-vat-ly-tap-1_')) {
        const val = JSON.parse(localStorage.getItem(k) || '{}');
        if (Array.isArray(val.readPages)) {
          totalReadPages += val.readPages.length;
        }
      }
    });
  } catch (e) {}

  const percent = Math.min(100, Math.round((totalReadPages / totalBookPages) * 100));
  const pctEl = document.getElementById('book-prog-percent');
  const barEl = document.getElementById('book-prog-bar');
  if (pctEl) pctEl.textContent = `${percent}% (${totalReadPages}/${totalBookPages} trang)`;
  if (barEl) barEl.style.width = `${percent}%`;
</script>
